<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation (requires Developer Mode on iOS 17+) -->
    <!-- This entitlement is automatically granted when Developer Mode is enabled -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (needed for RPCS3 recompilers) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow loading dynamic libraries (MoltenVK, etc.) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- File sharing for importing games -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- App sandbox (set to false for full filesystem access needed by emulator) -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
