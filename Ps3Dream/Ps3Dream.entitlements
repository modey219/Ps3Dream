<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation (requires Developer Mode on iOS 17+) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (needed for RPCS3 recompilers) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Allow loading dynamic libraries (MoltenVK, etc.) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- File sharing for importing games -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- App sandbox disabled for full filesystem access needed by emulator -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Raise memory limit (standard ~6GB → unlimited for RPCS3) -->
    <!-- Note: increased-memory-limit requires Apple developer entitlement -->
    <!-- <key>com.apple.developer.kernel.increased-memory-limit</key> -->
    <!-- <true/> -->

    <!-- Enable full 64-bit virtual address space (critical for JIT arena) -->
    <!-- Note: extended-virtual-addressing requires Apple developer entitlement -->
    <!-- <key>com.apple.developer.kernel.extended-virtual-addressing</key> -->
    <!-- <true/> -->
</dict>
</plist>
